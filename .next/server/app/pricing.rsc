r:var(--color-fg-muted)]","children":"Yes. ClueLake ingests OpenTelemetry and speaks PromQL for the supported query set, so existing dashboards and alert rules can keep working while telemetry lands here."}]]}]]}]]}]}],["$","section",null,{"className":"grid-field border-t border-[color:var(--color-line)] py-20","children":["$","div",null,{"className":"mx-auto w-full max-w-[1160px] px-5 sm:px-8","children":["$","div",null,{"className":"max-w-[40rem]","children":[["$","h2",null,{"className":"text-[clamp(2rem,4.5vw,3.1rem)] font-semibold tracking-[-0.03em]","children":"Stop asking what broke."}],["$","p",null,{"className":"mt-3 text-[clamp(1.25rem,2.6vw,1.75rem)] text-[color:var(--color-fg-muted)]","children":"Start with what changed."}],["$","div",null,{"className":"mt-8 flex flex-wrap gap-3","children":[["$","$L6",null,{"href":"/get-started","className":"inline-flex items-center justify-center gap-2 rounded-lg font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)] disabled:opacity-50 disabled:pointer-events-none bg-[color:var(--color-accent)] text-[#04141c] hover:bg-[color:var(--color-accent-hover)] h-11 px-5 text-[15px]","children":"Get started"}],["$","$L6",null,{"href":"/architecture","className":"inline-flex items-center justify-center gap-2 rounded-lg font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)] disabled:opacity-50 disabled:pointer-events-none border border-[color:var(--color-line-strong)] text-[color:var(--color-fg)] hover:bg-[color:var(--color-surface-2)] h-11 px-5 text-[15px]","children":"Explore the architecture"}]]}]]}]}]}]],null,["$","$L9",null,{"children":"$La"}]]}],{},null,false]},null,false]},null,false],["$","$1","h",{"children":[null,["$","$1","5tz6LfS-i6C5r_TkvuY0C",{"children":[["$","$Lb",null,{"children":"$Lc"}],["$","$Ld",null,{"children":"$Le"}],["$","meta",null,{"name":"next-siz