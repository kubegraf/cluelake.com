# Copy to .env.local for development. ⚠ NEVER COMMIT .env.local.
#
# ⚠ ONLY `NEXT_PUBLIC_*` VARIABLES REACH THE BROWSER. Everything else in this
# file is server-only and must stay that way — a provider key prefixed
# NEXT_PUBLIC_ is a key published in the JavaScript bundle.

# The site's own public URL. Canonical tags, OpenGraph and the sitemap are all
# built from it, so it must be correct per environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics. One of: plausible | posthog | ga4. Unset means no analytics script
# is loaded at all, which is the default.
# NEXT_PUBLIC_ANALYTICS=plausible

# ── Contact form (server-only) ──────────────────────────────────────────────
# With no provider configured the form REFUSES submissions rather than
# pretending to accept them. Leave unset in development.
# CONTACT_PROVIDER=resend
# CONTACT_TO=hello@example.com
# CONTACT_FROM=ClueLake <noreply@cluelake.com>
# RESEND_API_KEY=
